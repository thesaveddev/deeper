{
  "name": "deeper",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "npm run typecheck:app && npm run typecheck:workspaces",
    "typecheck:app": "tsc -p tsconfig.json",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm --workspace services/server run dev",
    "dev:mobile": "expo start",
    "dev": "concurrently -k -n SERVER,MOBILE -c blue,magenta \"npm run dev:server\" \"npx expo start\"",
    "dev:clear": "concurrently -k -n SERVER,MOBILE -c blue,magenta \"npm run dev:server\" \"npx expo start --clear\"",
    "assets": "node tools/generate-assets.mjs",
    "assets:preview": "node tools/preview-assets.mjs",
    "build:check": "node tools/check-build-readiness.mjs",
    "site:policy": "node tools/build-policy-page.mjs",
    "site:seo": "node tools/build-seo.mjs",
    "site:og": "node tools/build-og-images.mjs",
    "site:og:verify": "node tools/build-og-images.mjs --verify",
    "site:build": "npm run site:policy && npm run site:theme && npm run site:og && npm run site:seo",
    "site:serve": "node tools/serve-site.mjs",
    "site:audit": "node tools/audit-site.mjs",
    "site:textures": "node tools/generate-site-textures.mjs",
    "site:theme": "node tools/build-theme-toggle.mjs"
  },
  "dependencies": {
    "@deeper/content": "0.1.0",
    "@deeper/shared": "0.1.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.25",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "^10.10.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "react-native-reanimated": "~4.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "infra/*"
  ],
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
