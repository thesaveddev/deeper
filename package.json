{
  "name": "deeper",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*",
    "services/*",
    "infra/*"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "npm run typecheck:app && npm run typecheck:workspaces",
    "typecheck:app": "tsc -p tsconfig.json",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm --workspace services/server run dev",
    "dev:mobile": "expo start",
    "dev": "concurrently -k -n SERVER,MOBILE -c blue,magenta \"npm run dev:server\" \"npx expo start\"",
    "dev:clear": "concurrently -k -n SERVER,MOBILE -c blue,magenta \"npm run dev:server\" \"npx expo start --clear\""
  },
  "dependencies": {
    "@deeper/content": "0.1.0",
    "@deeper/shared": "0.1.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.24",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.20",
    "expo-router": "57.0.21",
    "expo-status-bar": "~3.0.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-purchases": "^10.10.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
