{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./*"],
      "@deeper/shared": ["./packages/shared/src/index.ts"],
      "@deeper/content": ["./packages/content/src/index.ts"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "packages/shared/src/**/*.ts",
    "packages/content/src/index.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
