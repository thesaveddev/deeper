{
  "expo": {
    "name": "DEEPER",
    "slug": "deeper",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "deeper",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0D0D12"
        }
      ],
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.deeper.mobile"
    },
    "android": {
      "package": "app.deeper.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D12"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
