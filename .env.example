# Server
NODE_ENV=development
PORT=4400
DATABASE_URL=postgresql://deeper:deeper@localhost:5432/deeper
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=*
ROOM_TTL_MINUTES=120

# Server-side gating of DEEPER+ decks (first-date, late-night, after-dark).
# 'on' (default) rejects them for accounts with no server-side entitlement.
# Set to 'off' ONLY for local testing before RevenueCat is wired up.
PREMIUM_ENFORCEMENT=on

# Mobile - the client auto-derives the server host from Metro, so in local dev
# you normally need nothing here. Set this ONLY for EAS/production builds and
# point it at a publicly reachable host (never localhost, never a LAN IP).
# EXPO_PUBLIC_SOCKET_URL=https://api.example.invalid
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
EXPO_PUBLIC_SENTRY_DSN=

# Optional server-side integrations
REVENUECAT_WEBHOOK_SECRET=
SENTRY_DSN=
